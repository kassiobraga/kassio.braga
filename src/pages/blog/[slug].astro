---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (e) => !e.data.rascunho);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---
<Base title={`${post.data.titulo} · Kassio Braga`} description={post.data.resumo}>
  <Nav blog={true} />
  <main class="wrap article-wrap">
    <a class="back" href="/blog"><Icon name="arrow-right" size={15} /><span>Todos os artigos</span></a>

    <header class="article-head">
      <div class="head-meta">
        <span class="ptag">{post.data.tag}</span>
        <span class="pdate">{fmt(post.data.data)}</span>
      </div>
      <h1>{post.data.titulo}</h1>
      <p class="resumo">{post.data.resumo}</p>
    </header>

    {post.data.capa && (
      <div class="frame blueprint capa">
        <span class="crop tr"></span>
        <span class="crop bl"></span>
        <img src={post.data.capa} alt={post.data.titulo} />
      </div>
    )}

    <article class="article">
      <Content />
    </article>

    <div class="article-foot">
      <p>Gostou ou discorda? O melhor lugar para continuar a conversa é o LinkedIn.</p>
      <a class="btn btn-primary" href="/#contato">Falar comigo</a>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .article-wrap{padding:42px 0 64px;max-width:760px}
  .back{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--navy);text-decoration:none}
  .back :global(svg){transform:rotate(180deg)}
  .back:hover{color:var(--pop)}

  .article-head{margin-top:26px}
  .head-meta{display:flex;align-items:center;gap:14px}
  .ptag{font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;border:2px solid var(--navy);background:var(--pastel-2);padding:5px 10px}
  .pdate{font-family:var(--mono);font-size:12px;letter-spacing:.5px;color:var(--jet);text-transform:uppercase}
  h1{font-family:var(--title);font-weight:800;font-size:clamp(30px,5vw,46px);line-height:1.05;letter-spacing:-1.2px;color:var(--navy);margin-top:18px}
  .resumo{font-size:19px;line-height:1.6;color:var(--jet);margin-top:18px}

  .capa{aspect-ratio:16/9;margin-top:30px}

  .article{margin-top:34px;font-size:17px;line-height:1.75;color:var(--jet)}
  .article :global(h2){font-family:var(--title);font-weight:800;font-size:28px;letter-spacing:-.6px;color:var(--navy);margin:38px 0 0}
  .article :global(h3){font-family:var(--title);font-weight:600;font-size:21px;letter-spacing:-.3px;color:var(--navy);margin:30px 0 0}
  .article :global(p){margin-top:16px}
  .article :global(ul),.article :global(ol){margin:16px 0 0 1.2em}
  .article :global(li){margin-top:8px}
  .article :global(strong){color:var(--navy)}
  .article :global(a){color:var(--pop);text-decoration:underline;text-underline-offset:3px}
  .article :global(blockquote){border-left:5px solid var(--pop);background:var(--white);border-top:2px solid var(--navy);border-right:2px solid var(--navy);border-bottom:2px solid var(--navy);box-shadow:5px 5px 0 var(--navy);padding:18px 22px;margin:26px 0 0;font-family:var(--title);font-weight:600;font-size:18px;color:var(--navy);line-height:1.5}
  .article :global(blockquote p){margin-top:0}
  .article :global(img){border:3px solid var(--navy);box-shadow:8px 8px 0 var(--navy);margin:28px 0 0}
  .article :global(code){font-family:var(--mono);font-size:.85em;background:var(--pastel-2);border:1px solid var(--navy);padding:1px 5px}

  .article-foot{margin-top:48px;border-top:3px solid var(--navy);padding-top:26px;display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
  .article-foot p{font-size:16px;color:var(--jet);max-width:30em}
