---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import PxDivider from '../components/pixel/PxDivider.astro';

const atalhos = [
  { href: '/#sobre', label: 'Sobre' },
  { href: '/#historia', label: 'História' },
  { href: '/#cases', label: 'Cases' },
  { href: '/#palestras', label: 'Palestras' },
  { href: '/#contato', label: 'Contato' },
];
---
<Base title="Fora da planta · Kassio Braga" description="Esse endereço não está na planta do site. Volte para o início ou leia o blog." noindex>
  <Nav blog={true} />
  <main class="wrap erro">
    <div class="erro-grid">
      <div class="erro-texto">
        <div class="kicker"><span class="bar"></span>Erro 404 · fora da planta</div>
        <h1>Esse cômodo não está na planta.</h1>
        <PxDivider />
        <p class="lead">
          O endereço que você tentou abrir não existe ou mudou de lugar na reforma.
          Acontece até em obra bem tocada. O resto da casa está de pé e no prumo.
        </p>
        <div class="acoes">
          <a class="btn btn-primary" href="/">Voltar para o início</a>
          <a class="btn btn-ghost" href="/blog">Ler o blog</a>
        </div>
        <div class="atalhos">
          <span class="lab">Ou vá direto para</span>
          <ul>
            {atalhos.map((a) => <li><a href={a.href}>{a.label}</a></li>)}
          </ul>
        </div>
      </div>

      <div class="erro-planta">
        <span class="tick cota">fig.404</span>
        <div class="frame planta-frame">
          <svg viewBox="0 0 420 320" role="img" aria-label="Planta baixa de uma casa em que um dos cômodos aparece só tracejado, marcado como 404">
            <rect width="420" height="320" fill="#0A1730" />
            <g stroke="#FFFFFF" stroke-width="1" opacity="0.07">
              {Array.from({ length: 13 }, (_, i) => <line x1="0" y1={i * 25} x2="420" y2={i * 25} />)}
              {Array.from({ length: 17 }, (_, i) => <line x1={i * 25} y1="0" x2={i * 25} y2="320" />)}
            </g>

            <g fill="none" stroke="#EAEEF6" stroke-width="3">
              <path d="M60 70 H250 V250 H60 Z" />
              <line x1="60" y1="160" x2="160" y2="160" />
              <line x1="160" y1="70" x2="160" y2="250" />
              <line x1="160" y1="190" x2="250" y2="190" />
            </g>
            <path d="M160 160 a20 20 0 0 1 20 -20" fill="none" stroke="#0070FE" stroke-width="2" />
            <line x1="160" y1="140" x2="160" y2="160" stroke="#0A1730" stroke-width="4" />

            <g class="comodo-fantasma" fill="none" stroke="#0070FE" stroke-width="2.5" stroke-dasharray="8 7">
              <path d="M250 70 H370 V190 H250" />
            </g>
            <text x="310" y="122" fill="#0070FE" font-family="'Space Mono',monospace" font-size="34" font-weight="700" text-anchor="middle">404</text>
            <text x="310" y="146" fill="#9db8e6" font-family="'Space Mono',monospace" font-size="10" text-anchor="middle">não executado</text>

            <g stroke="#0070FE" stroke-width="1.5">
              <line x1="60" y1="50" x2="370" y2="50" />
              <line x1="60" y1="45" x2="60" y2="55" /><line x1="250" y1="45" x2="250" y2="55" /><line x1="370" y1="45" x2="370" y2="55" />
              <line x1="390" y1="70" x2="390" y2="190" />
              <line x1="385" y1="70" x2="395" y2="70" /><line x1="385" y1="190" x2="395" y2="190" />
            </g>
            <text x="155" y="42" fill="#9db8e6" font-family="'Space Mono',monospace" font-size="10" text-anchor="middle">projeto aprovado</text>
            <text x="310" y="42" fill="#9db8e6" font-family="'Space Mono',monospace" font-size="10" text-anchor="middle">??? m</text>

            <text x="110" y="120" fill="#9db8e6" font-family="'Space Mono',monospace" font-size="10" text-anchor="middle">início</text>
            <text x="110" y="210" fill="#9db8e6" font-family="'Space Mono',monospace" font-size="10" text-anchor="middle">blog</text>
            <text x="205" y="225" fill="#9db8e6" font-family="'Space Mono',monospace" font-size="10" text-anchor="middle">contato</text>

            <g fill="#0070FE">
              <rect x="372" y="276" width="10" height="10" /><rect x="384" y="276" width="10" height="10" />
              <rect x="372" y="288" width="10" height="10" />
            </g>
          </svg>
          <div class="cap"><span>planta baixa · revisão 404</span><b>KB</b></div>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Base>

<style>
  .erro{padding-top:110px;padding-bottom:100px}
  .erro-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
  .erro-texto h1{font-family:var(--title);font-weight:800;font-size:clamp(34px,5vw,56px);line-height:1.04;letter-spacing:-1.5px;color:var(--navy);margin:14px 0 18px}
  .erro .lead{font-size:18px;line-height:1.65;color:var(--jet);margin-top:20px;max-width:30em}
  .acoes{display:flex;flex-wrap:wrap;gap:16px;margin-top:30px}
  .atalhos{margin-top:34px}
  .atalhos .lab{font-family:var(--mono);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--jet)}
  .atalhos ul{list-style:none;display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:10px}
  .atalhos a{color:var(--navy);font-weight:600;text-decoration:underline;text-underline-offset:3px}
  .atalhos a:hover{color:var(--pop)}

  .erro-planta{position:relative}
  .erro-planta .cota{top:-20px;right:0}
  .planta-frame{aspect-ratio:21/16;background:#0A1730}
  .planta-frame svg{width:100%;height:100%;display:block}
  .comodo-fantasma{animation:tracejado 2.4s linear infinite}
  @keyframes tracejado{to{stroke-dashoffset:-30}}
  @media (prefers-reduced-motion: reduce){.comodo-fantasma{animation:none}}

  @media(max-width:880px){
    .erro{padding-top:80px;padding-bottom:72px}
    .erro-grid{grid-template-columns:1fr;gap:44px}
  }
</style>
