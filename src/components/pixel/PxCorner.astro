---
// Canto pixelado, assinatura retrô. Azul #0070FE, módulo 16px / quadrado 14px.
interface Props { size?: number; class?: string; }
const { size = 46, class: cls = '' } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 46 46" shape-rendering="crispEdges" aria-hidden="true">
  <g fill="#0070FE">
    <rect x="0" y="0" width="14" height="14" />
    <rect x="16" y="0" width="14" height="14" />
    <rect x="0" y="16" width="14" height="14" />
  </g>
</svg>
