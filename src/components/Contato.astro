---
import PxDivider from './pixel/PxDivider.astro';
import Icon from './Icon.astro';
import { site } from '../data/site.ts';

const caminhos = [
  { icon: 'mic', titulo: 'Palestra', desc: 'Palco, painel ou workshop para o seu evento ou time.' },
  { icon: 'handshake', titulo: 'Parceria', desc: 'Co-criação, indicação ou projeto em conjunto com a All.Q.' },
  { icon: 'graduation-cap', titulo: 'Mentoria', desc: 'Sessão de marketing, automação ou growth para fundadores.' },
];
---
<section class="contato" id="contato">
  <div class="wrap">
    <div class="sec-head">
      <div class="kicker"><span class="bar"></span>Contato · vamos conversar</div>
      <h2>Aberto a palco, parceria e troca real.</h2>
      <p class="sub">O melhor caminho é o LinkedIn, onde respondo e mantenho a conversa. Diga o que você tem em mente e a gente encontra o formato.</p>
      <PxDivider />
    </div>

    <div class="caminhos">
      {caminhos.map((c) => (
        <div class="caminho">
          <Icon name={c.icon} size={28} stroke="#0A1730" />
          <h3>{c.titulo}</h3>
          <p>{c.desc}</p>
        </div>
      ))}
    </div>

    <div class="canais">
      <a class="canal primary" href={site.linkedin} target="_blank" rel="noopener">
        <div class="canal-in">
          <div class="canal-lab"><Icon name="arrow-up-right" size={18} stroke="#FFFFFF" /><span>Principal</span></div>
          <div class="canal-nome">LinkedIn</div>
          <div class="canal-val">{site.linkedinHandle}</div>
        </div>
      </a>

      <div class="canal-col">
        <a class="canal" href={`mailto:${site.email}`}>
          <div class="canal-lab"><Icon name="mail" size={16} stroke="#0A1730" /><span>E-mail</span></div>
          <div class="canal-val">{site.email}</div>
        </a>
        <a class="canal" href={site.whatsappLink} target="_blank" rel="noopener">
          <div class="canal-lab"><Icon name="message-circle" size={16} stroke="#0A1730" /><span>WhatsApp</span></div>
          <div class="canal-val">{site.whatsapp}</div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contato{padding:66px 0 60px}
  .caminhos{display:grid;grid-template-columns:repeat(3,1fr);gap:0;border:3px solid var(--navy);background:var(--white);margin-top:8px}
  .caminho{padding:26px 22px;border-right:1px solid rgba(10,23,48,.16)}
  .caminho:last-child{border-right:0}
  .caminho h3{font-family:var(--title);font-weight:800;font-size:21px;letter-spacing:-.4px;margin-top:14px}
  .caminho p{font-size:14px;line-height:1.55;color:var(--jet);margin-top:8px}

  .canais{display:grid;grid-template-columns:1.2fr 1fr;gap:24px;margin-top:30px}
  .canal{display:block;text-decoration:none;border:3px solid var(--navy);background:var(--white);color:var(--navy);padding:22px;box-shadow:6px 6px 0 var(--navy);transition:transform .12s,box-shadow .12s}
  .canal:hover{transform:translate(2px,2px);box-shadow:4px 4px 0 var(--pop)}
  .canal-lab{display:flex;align-items:center;gap:8px;font-family:var(--mono);font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--jet)}
  .canal-nome{font-family:var(--title);font-weight:800;font-size:34px;letter-spacing:-1px;margin-top:14px}
  .canal-val{font-family:var(--mono);font-size:14px;letter-spacing:.5px;margin-top:8px;color:var(--navy)}

  .canal.primary{background:var(--pop);color:var(--white);box-shadow:8px 8px 0 var(--navy);display:flex;align-items:center;min-height:170px}
  .canal.primary:hover{box-shadow:5px 5px 0 var(--navy)}
  .canal.primary .canal-lab{color:#d6e6ff}
  .canal.primary .canal-val{color:#eaf2ff}

  .canal-col{display:grid;gap:24px}
  .canal-col .canal-val{font-size:13px}

  @media(max-width:760px){
    .caminhos{grid-template-columns:1fr}
    .caminho{border-right:0;border-bottom:1px solid rgba(10,23,48,.16)}
    .caminho:last-child{border-bottom:0}
    .canais{grid-template-columns:1fr}
  }
</style>
